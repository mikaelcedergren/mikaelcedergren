{
  "name": "mikaelcedergren.com",
  "version": "1.0.0",
  "private": true,
  "description": "mikaelcedergren.com — Angular 22 SSG site, prerendered to static files and served by Express on the Mac mini.",
  "author": "Mikael Cedergren <michael@wargr.com>",
  "license": "UNLICENSED",
  "homepage": "https://mikaelcedergren.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelcedergren/mikaelcedergren.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "ng serve --configuration local --host 127.0.0.1 --port 4250",
    "build": "node scripts/sitemap.mjs && ng build --configuration prod && node scripts/flatten.mjs",
    "build:release": "ng build --configuration prod --output-path \"$SITE_RELEASE_DIR\" && node scripts/flatten.mjs",
    "build:local": "node scripts/sitemap.mjs && ng build --configuration local && node scripts/flatten.mjs",
    "start": "node server/index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "compression": "^1.7.5",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mikaelcedergren/cx-framework",
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
