{
  "name": "mikaelcedergren.com",
  "version": "1.0.0",
  "private": true,
  "description": "mikaelcedergren.com — Angular 22 SSG site, prerendered to static files and served by Express on the Mac mini.",
  "author": "Mikael Cedergren <michael@wargr.com>",
  "license": "UNLICENSED",
  "homepage": "https://mikaelcedergren.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelcedergren/mikaelcedergren.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "ng serve --configuration local --host 127.0.0.1 --port 4250",
    "build": "pnpm run build:browser && pnpm run build:server",
    "build:browser": "node scripts/sitemap.mjs && ng build --configuration prod && node scripts/flatten.mjs",
    "build:server": "pnpm --dir server build",
    "build:server:release": "cx-server-artifact --package mikaelcedergren-server",
    "build:release": "ng build --configuration prod --output-path \"$SITE_RELEASE_DIR\" && node scripts/flatten.mjs",
    "build:local": "node scripts/sitemap.mjs && ng build --configuration local && node scripts/flatten.mjs",
    "start": "node server/dist/index.js",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:server",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "pnpm --dir server typecheck",
    "test": "pnpm run test:build && pnpm run test:server",
    "test:build": "node --test tests/e2e-environment.test.mjs tests/flatten.test.mjs tests/launchd-contract.test.mjs",
    "test:server": "pnpm run build:server && node --test tests/server-contract.test.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "platform:check": "cx-platform-check --root .",
    "check": "pnpm format:check && pnpm platform:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "ag-charts-community": "^13.3.1",
    "marked": "^18.0.7",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@playwright/test": "1.60.0",
    "@types/node": "^26.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  }
}
